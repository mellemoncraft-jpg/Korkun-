.github/workflows/build.yml
name: build
on: [push, workflow_dispatch]
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - uses: gradle/actions/setup-gradle@v3
        with:
          gradle-version: 8.5
      - run: unzip -oq KorkuncCanavarlar.zip
      - run: cd KorkuncCanavarlar && gradle build --no-daemon
      - uses: actions/upload-artifact@v4
        with:
          name: jar
          path: KorkuncCanavarlar/build/libs/korkunc-canavarlar-1.0.0.jar
